NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Credential Docker được sinh trong named volume, không nằm trong file này.
POSTGRES_DB=agent_builder
POSTGRES_PORT=5432

REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=256mb
CACHE_REDIS_URL=redis://localhost:6380
REDIS_QUEUE_PORT=6381
QUEUE_REDIS_URL=redis://localhost:6381

S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_BUCKET_DOCUMENTS=agent-documents
S3_BUCKET_OUTPUTS=agent-outputs
S3_BUCKET_BACKUPS=agent-backups

