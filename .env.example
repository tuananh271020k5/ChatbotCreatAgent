# ==============================================================================
# AI AGENT BUILDER PLATFORM - BIẾN MÔI TRƯỜNG DÙNG CHUNG / LOCAL DOCKER
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi trường & Cổng dịch vụ
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
API_INTERNAL_URL=http://localhost:3001/api

# CSRF Trusted Origins (phân tách dấu phẩy)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL & pgvector
# Credential Docker được sinh trong named volume local_secrets
# ------------------------------------------------------------------------------
POSTGRES_DB=agent_builder
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent_application:postgres_application_password@localhost:5432/agent_builder
MIGRATION_DATABASE_URL=postgresql://agent_migration:postgres_migration_password@localhost:5432/agent_builder

# ------------------------------------------------------------------------------
# 3. Redis Kép (Cache & Queue)
# ------------------------------------------------------------------------------
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=256mb
CACHE_REDIS_URL=redis://localhost:6380

REDIS_QUEUE_PORT=6381
QUEUE_REDIS_URL=redis://localhost:6381

# ------------------------------------------------------------------------------
# 4. Object Storage S3 (SeaweedFS Local)
# ------------------------------------------------------------------------------
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=platform_admin
S3_SECRET_KEY=seaweed_admin_secret
S3_BUCKET_DOCUMENTS=agent-documents
S3_BUCKET_OUTPUTS=agent-outputs
S3_BUCKET_BACKUPS=agent-backups

# ------------------------------------------------------------------------------
# 5. Keycloak OIDC
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agent-builder
KEYCLOAK_CLIENT_ID=agent-builder-web
KEYCLOAK_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=agent-builder
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agent-builder-web
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

# ------------------------------------------------------------------------------
# 6. Bảo mật Phiên & Khóa mã hóa Credential
# ------------------------------------------------------------------------------
AUTH_SESSION_COOKIE_NAME=agent_builder_session
AUTH_CSRF_COOKIE_NAME=agent_builder_csrf
AUTH_SESSION_TTL_HOURS=168
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APPLICATION_KEYRING={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}

# ------------------------------------------------------------------------------
# 7. Devtools & Mailpit
# ------------------------------------------------------------------------------
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
DB_ADMIN_PORT=8088
REDIS_ADMIN_PORT=8081
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@agentbuilder.local
