# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (Next.js Application)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi trường & Cổng chạy
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL công khai của Frontend (truy cập từ trình duyệt người dùng)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Kết nối Backend API (NestJS)
# ------------------------------------------------------------------------------
# URL của Backend API mà trình duyệt sẽ gửi request tới
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# URL gọi nội bộ từ Server Components / SSR (Node.js runtime gọi trực tiếp tới NestJS trong container/mạng nội bộ)
API_INTERNAL_URL=http://localhost:3001/api

# ------------------------------------------------------------------------------
# 3. Cấu hình OIDC / Keycloak Client phía Web
# ------------------------------------------------------------------------------
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=agent-builder
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agent-builder-web
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak

