{
  "name": "ai-agent-builder-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Base monorepo for the AI Agent Builder and Workflow Engine platform.",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10.9.3 <11"
  },
  "scripts": {
    "ai:sync": "node scripts/sync-ai-config.mjs",
    "ai:check": "node scripts/sync-ai-config.mjs --check",
    "dev:backend": "npm run start:dev --workspace @agent-builder/backend",
    "dev:frontend": "npm run dev --workspace @agent-builder/frontend",
    "docker:config": "docker compose -f deployment/compose.yaml config",
    "docker:up": "docker compose -f deployment/compose.yaml up -d --build",
    "docker:dev": "docker compose -f deployment/compose.yaml -f deployment/compose.dev.yaml up --build",
    "docker:down": "docker compose -f deployment/compose.yaml down",
    "docker:logs": "docker compose -f deployment/compose.yaml logs -f",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
