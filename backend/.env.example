# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND (NestJS API Service)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi trường & Cổng dịch vụ
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_PREFIX=api
API_URL=http://localhost:3001

# Địa chỉ URL công khai của Frontend (Next.js)
WEB_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Danh sách Origin tin cậy cho CSRF (cách nhau bởi dấu phẩy, không có dấu gạch chéo cuối)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu PostgreSQL (pgvector)
# ------------------------------------------------------------------------------
# Tài khoản agent_application (DML runtime cho ứng dụng chính)
DATABASE_URL=postgresql://agent_application:postgres_application_password@localhost:5432/agent_builder
# Hoặc nạp qua Docker Secret: DATABASE_URL_FILE=/run/secrets/database_url

# Tài khoản agent_migration (DDL cho migration runner)
MIGRATION_DATABASE_URL=postgresql://agent_migration:postgres_migration_password@localhost:5432/agent_builder
# Hoặc nạp qua Docker Secret: MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url

# ------------------------------------------------------------------------------
# 3. Redis Kép (Tách biệt Cache và Hàng đợi BullMQ)
# ------------------------------------------------------------------------------
# Redis Cache (allkeys-lru, không lưu disk, port 6380)
CACHE_REDIS_URL=redis://localhost:6380
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=256mb

# Redis Queue (BullMQ, appendonly everysec, noeviction, port 6381)
QUEUE_REDIS_URL=redis://localhost:6381
REDIS_QUEUE_PORT=6381

# ------------------------------------------------------------------------------
# 4. Lưu trữ đối tượng S3 / SeaweedFS Local
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_ACCESS_KEY=platform_admin
S3_SECRET_KEY=seaweed_admin_secret
S3_FORCE_PATH_STYLE=true

# Tên các Bucket
S3_BUCKET_DOCUMENTS=agent-documents
S3_BUCKET_OUTPUTS=agent-outputs
S3_BUCKET_BACKUPS=agent-backups

# ------------------------------------------------------------------------------
# 5. Xác thực Danh tính OIDC / Keycloak
# ------------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agent-builder
KEYCLOAK_CLIENT_ID=agent-builder-web
KEYCLOAK_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
OIDC_SCOPES=openid profile email

# ------------------------------------------------------------------------------
# 6. Quản lý Phiên Đăng nhập & CSRF
# ------------------------------------------------------------------------------
AUTH_SESSION_COOKIE_NAME=agent_builder_session
AUTH_CSRF_COOKIE_NAME=agent_builder_csrf
AUTH_SESSION_TTL_HOURS=168

# ------------------------------------------------------------------------------
# 7. Mã hóa Khóa bí mật (AES-256-GCM với Keyring Versioning)
# ------------------------------------------------------------------------------
# Khóa 256-bit (64 ký tự hex) cho môi trường dev/local
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Chuỗi JSON chứa keyring phiên bản hóa (hỗ trợ luân chuyển khóa không làm hỏng dữ liệu cũ)
APPLICATION_KEYRING={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}

# ------------------------------------------------------------------------------
# 8. Email / SMTP (Mailpit Devtools)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@agentbuilder.local

