{
  "name": "@agent-builder/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/database/migrations/migrate.ts",
    "migrate:production": "node dist/database/migrations/migrate.js",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('Thiếu TEST_DATABASE_URL')\" && vitest run test/database.integration.spec.ts test/database-migration.integration.spec.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agent-builder/contracts": "0.1.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
